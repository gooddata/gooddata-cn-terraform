# KEDA autoscaling opt-in per component. Available from GoodData.CN 4.12.0.
# Replica bounds and CPU targets come from the chart defaults, overridden per
# component in the size profiles where the profile's replicaCount differs.
analyticalDesigner:
  kedaAutoscaling:
    enabled: true
dashboards:
  kedaAutoscaling:
    enabled: true
homeUi:
  kedaAutoscaling:
    enabled: true
apiGw:
  kedaAutoscaling:
    enabled: true
authService:
  kedaAutoscaling:
    enabled: true
metadataApi:
  kedaAutoscaling:
    enabled: true
afmExecApi:
  kedaAutoscaling:
    enabled: true
calcique:
  kedaAutoscaling:
    enabled: true
resultCache:
  kedaAutoscaling:
    enabled: true
%{ if prometheus_address != "" ~}
# export-builder and gen-ai-metadata-sync scale on Prometheus queries (browser-pool
# saturation, projection outbox queue), not CPU, so they need the observability stack.
kedaAutoscaling:
  prometheusAddress: "${prometheus_address}"
exportBuilder:
  kedaAutoscaling:
    enabled: true
genAiMetadataSync:
  kedaAutoscaling:
    enabled: true
%{ else ~}
# No Prometheus: export-builder cannot autoscale, so run a static pair.
exportBuilder:
  replicaCount: 2
%{ endif ~}
