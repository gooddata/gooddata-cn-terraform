# KEDA autoscaling opt-in per component. Available from GoodData.CN 4.12.0.
# Replica bounds and CPU targets come from the chart defaults, overridden per
# component in the size profiles where the profile's replicaCount differs.
analyticalDesigner:
  kedaAutoscaling:
    enabled: true
dashboards:
  kedaAutoscaling:
    enabled: true
homeUi:
  kedaAutoscaling:
    enabled: true
apiGw:
  kedaAutoscaling:
    enabled: true
authService:
  kedaAutoscaling:
    enabled: true
metadataApi:
  kedaAutoscaling:
    enabled: true
afmExecApi:
  kedaAutoscaling:
    enabled: true
calcique:
  kedaAutoscaling:
    enabled: true
resultCache:
  kedaAutoscaling:
    enabled: true
%{ if prometheus_address != "" ~}
# export-builder scales on a Prometheus query (browser-pool saturation), not CPU,
# so it is only enabled when the observability stack provides Prometheus.
kedaAutoscaling:
  prometheusAddress: "${prometheus_address}"
exportBuilder:
  kedaAutoscaling:
    enabled: true
%{ endif ~}
