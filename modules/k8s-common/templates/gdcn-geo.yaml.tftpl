# Geo chart basemap provider. Credentials stay on api-gw, never in the browser.

apiGw:
%{ if provider == "awslocation" ~}
  awsLocationRegion: "${aws_location_region}"
  locationService:
    plugin: "AwsLocation"
%{ endif ~}
%{ if provider == "mapbox" ~}
  locationService:
    plugin: "MapboxLocation"
    mapbox:
      existingSecret: "${mapbox_secret_name}"
      existingSecretKey: "token"
%{ endif ~}
