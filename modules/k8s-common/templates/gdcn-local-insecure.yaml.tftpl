# Exports reach the ingress over loopback via the socat sidecar, with a
# self-signed certificate that Chrome must accept.

visualExporterProxy:
  permittedDestinations: "127.0.0.1/32 ::1/128"

exportBuilder:
  extraEnvVars:
    - name: CHROME_FLAGS_EXTRA
      value: "--ignore-certificate-errors --allow-insecure-localhost"
