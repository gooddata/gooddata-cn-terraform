# Apply GoodData.CN "dev" size profile

replicaCount: 1

# Autoscaling bounds: single-replica baseline, low ceiling.
kedaAutoscaling:
  minReplicaCount: 1
  maxReplicaCount: 3

# export-builder and gen-ai-metadata-sync read only their own bounds, not the
# profile-level ones above. Both scale on a Prometheus metric that their own pods
# emit, so minReplicaCount must stay >= 1: at zero replicas the metric disappears,
# the query returns null (ignoreNullValues=true -> 0) and nothing can scale them
# back up.
exportBuilder:
  replicaCount: 1
  kedaAutoscaling:
    minReplicaCount: 1
    maxReplicaCount: 3
genAiMetadataSync:
  kedaAutoscaling:
    minReplicaCount: 1
    maxReplicaCount: 3

mcpServer:
  replicaCount: 1

redis-ha:
  replicas: 1
  hardAntiAffinity: false
  redis:
    config:
      min-replicas-to-write: 0
  sentinel:
    quorum: 1
  persistentVolume:
    size: 1Gi

customEtcd:
  replicaCount: 1
  antiAffinity:
    enabled: false
  persistence:
    size: 1Gi

qdrant:
  replicaCount: 1
  config:
    storage:
      collection:
        replication_factor: 1
        write_consistency_factor: 1
  persistence:
    size: 1Gi
