# GoodData.CN "prod-large" size profile (last updated: 2026-07-09)
#
# High-traffic multi-tenant sizing: more hot-path replicas + CPU/memory than
# prod-small, dedicated Quiver policy nodes, larger result cache.
#
# AI Lake is sized separately via var.ai_lake_size_profile
# (dev/prod-small/prod-xl); it is not derived from this profile.

replicaCount: 2

platform_limits:
  max_column_size: 2000
  max_dimension_size: 1000000
  max_result_bytes: 500000000
  max_result_cell_count: 50000000
  # Double the limit of page size in AFM so that tabular-exporter can still
  # load 1000 row pages even with the new 2000 column limit.
  max_afm_result_page_bytes: 10485760
  # Raise export timeout to 7 min (default 5); large exports (esp. XLSX) can
  # exceed the default.
  export_result_timeout_seconds: 420

# Deploy dedicated Quiver policy nodes so policy-handling load is taken off the
# cache nodes, preventing hiccups during high load and releases.
deployDedicatedPolicyNodes: true

# Long-poll AFM execution results instead of client polling.
enableAfmLongPoll: true

afmExecApi:
  # Netty/WebFlux: blocking calls use Dispatchers.IO (64-thread default caps
  # ~50 req/pod). io.parallelism + ActiveProcessorCount raise per-pod concurrency.
  jvmOptions: -XX:MaxMetaspaceSize=256M -XX:MaxDirectMemorySize=200M -XX:ActiveProcessorCount=8 -Dkotlinx.coroutines.io.parallelism=128 -XX:MaxRAMPercentage=47
  # Deploys at the autoscaling floor; the ceiling is peak-provisioned,
  # since fewer replicas regress execute latency sharply under high load.
  replicaCount: 6
  kedaAutoscaling:
    # Fast scale-up: the chart default (300 s window) recovers too slowly.
    behavior: &fastScaleUp
      scaleUp:
        stabilizationWindowSeconds: 0
        selectPolicy: Max
        policies:
          - type: Pods
            value: 4
            periodSeconds: 30
          - type: Percent
            value: 100
            periodSeconds: 30
    minReplicaCount: 6
    maxReplicaCount: 16
  resources:
    limits:
      cpu: 3000m
      memory: 3600Mi
    requests:
      cpu: 1500m
      memory: 3600Mi
analyticalDesigner:
  resources:
    limits:
      cpu: 200m
      memory: 45Mi
    requests:
      memory: 15Mi
apiDocs:
  resources:
    limits:
      cpu: 200m
      memory: 45Mi
    requests:
      cpu: 20m
      memory: 15Mi
apiGateway:
  jvmOptions: -Xmx225M -XX:MaxMetaspaceSize=128M -XX:MaxDirectMemorySize=512M
  replicaCount: 3
  resources:
    limits:
      cpu: 1500m
      memory: 1Gi
    requests:
      cpu: 100m
      memory: 1Gi
authService:
  jvmOptions: -XX:MaxMetaspaceSize=160M -XX:MaxDirectMemorySize=32M -XX:MaxRAMPercentage=31
  replicaCount: 2
  resources:
    limits:
      cpu: 500m
      memory: 820Mi
    requests:
      cpu: 100m
      memory: 820Mi
automation:
  # Disable the dead Zipkin exporter (see metadataApi).
  extraEnvVars:
    - name: MANAGEMENT_ZIPKIN_TRACING_EXPORT_ENABLED
      value: "false"
calcique:
  jvmOptions: -XX:MaxMetaspaceSize=320M -XX:MaxDirectMemorySize=512M -XX:MaxRAMPercentage=36
  replicaCount: 8
  kedaAutoscaling:
    behavior: *fastScaleUp
    minReplicaCount: 8
    maxReplicaCount: 28
  resources:
    limits:
      cpu: 4000m
      memory: 2800Mi
    requests:
      cpu: 1500m
      memory: 2800Mi
customEtcd:
  enabled: true
  resources:
    requests:
      cpu: 3000m
      memory: 13Gi
    limits:
      cpu: 3000m
      memory: 13Gi
%{ if cloud == "aws" ~}
  # Dedicated nodes from the "etcd" Karpenter NodePool (aws/karpenter.tf).
  nodeSelector:
    workload: etcd
  tolerations:
    - key: dedicated
      operator: Equal
      value: etcd
      effect: NoSchedule
%{ endif ~}
  # Down from 512Gi, which was far more than etcd can use. A StatefulSet
  # volumeClaimTemplate is immutable, so an existing prod-large install rejects
  # this on upgrade. Migrating means snapshotting etcd, deleting the
  # StatefulSet with --cascade=orphan plus its PVCs, then re-applying and
  # restoring — do not delete PVCs without a snapshot, the flight catalog
  # lives on that disk.
  persistence:
    size: 30Gi
  # Compact every 30 min (chart default 5m): frequent compaction slowed etcd and stalled Quiver reads.
  autoCompaction:
    mode: periodic
    retention: 30m
dashboards:
  replicaCount: 3
  kedaAutoscaling:
    minReplicaCount: 3
    maxReplicaCount: 16
  resources:
    limits:
      cpu: 1000m
      memory: 128Mi
    requests:
      cpu: 200m
      memory: 32Mi
exportController:
  jvmOptions: -Xmx1024M -XX:MaxMetaspaceSize=256M -XX:MaxDirectMemorySize=128M
  replicaCount: 4
  # Pin: the chart default follows the export-builder maximum and would change the pod template.
  builderRetry:
    podsPerRetry: 10
  resources:
    limits:
      cpu: 2000m
      memory: 2560Mi
    requests:
      cpu: 500m
      memory: 1536Mi
# GenAI services (only deployed when AI features are enabled).
# Safe to leave in place when AI features are off.
genAiService:
  fastembed:
    metadata_sync_workers: 10
  pulsar:
    metadataSync:
      max_consumer_concurrency: 100
  resources:
    limits:
      cpu: 4000m
      memory: 7168Mi
    requests:
      cpu: 2000m
      memory: 5120Mi
genAi:
  resources:
    limits:
      cpu: 4000m
      memory: 6144Mi
    requests:
      cpu: 2000m
      memory: 3072Mi
genAiMetadataSync:
  resources:
    limits:
      cpu: 3000m
      memory: 6144Mi
    requests:
      cpu: 1500m
      memory: 4096Mi
homeUi:
  resources:
    limits:
      cpu: 500m
      memory: 45Mi
    requests:
      cpu: 50m
      memory: 15Mi
ldmModeler:
  resources:
    limits:
      cpu: 200m
      memory: 60Mi
    requests:
      cpu: 20m
      memory: 15Mi
measureEditor:
  resources:
    limits:
      cpu: 200m
      memory: 45Mi
    requests:
      cpu: 20m
      memory: 15Mi
metadataApi:
  # io.parallelism must rise with the Hikari pool: each blocking coroutine thread
  # holds a connection, so io.parallelism=16 pins the pool at the default 16 and
  # gRPC latency climbs to ~1s. 4 pods x 48 fits the RDS connection ceiling.
  extraEnvVars:
    - name: SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE
      value: "48"
    - name: SPRING_DATASOURCE_HIKARI_MINIMUMIDLE
      value: "8"
    # Disable the auto-configured Zipkin exporter: it retries localhost:9411 and
    # throttles span export, dropping downstream spans from Tempo under load.
    - name: MANAGEMENT_ZIPKIN_TRACING_EXPORT_ENABLED
      value: "false"
  jvmOptions: -XX:MaxMetaspaceSize=256M -XX:MaxDirectMemorySize=128M -XX:ActiveProcessorCount=4 -Dkotlinx.coroutines.io.parallelism=48 -XX:MaxRAMPercentage=82
  pulsar:
    metadataSync:
      messageTTL: 3600
  replicaCount: 6
  kedaAutoscaling:
    behavior: *fastScaleUp
    minReplicaCount: 6
    maxReplicaCount: 20
    targetCPUUtilization: 60
  resources:
    limits:
      # metadataApi is the busiest service (every AFM execute calls it via the
      # existEntitlement gRPC). A CPU limit below the JVM's assumed core count
      # causes CFS throttling that starves the actuator thread and trips the
      # liveness probe under load.
      cpu: 4000m
      memory: 7300Mi
    requests:
      # Reserve real headroom so the scheduler protects this hot-path service
      # from noisy neighbors rather than leaving it to burst-and-throttle.
      cpu: 3000m
      memory: 7300Mi
organizationController:
  resources:
    limits:
      cpu: 500m
      memory: 384Mi
    requests:
      cpu: 100m
      memory: 200Mi
pdfStaplerService:
  jvmOptions: -Xmx800M -XX:MaxMetaspaceSize=128M -XX:MaxDirectMemorySize=32M
  resources:
    limits:
      cpu: 500m
      memory: 1500Mi
    requests:
      cpu: 100m
      memory: 1500Mi
qdrant:
  persistence:
    size: 30Gi
  resources:
    limits:
      cpu: 2000m
      memory: 6000Mi
    requests:
      cpu: 1000m
      memory: 3500Mi
quiver:
  # Slow xtab boot with 12-16 workers failed the liveness probe, so delay it to 60 s.
  service:
    liveness:
      initialDelaySeconds: 60
  # Fewer flights mean fewer etcd keys, shorter compactions and smaller flight views.
  limitFlightCount: 75000
  # Per quiver-cache pod, 12 x 6000 stays below limitFlightCount.
  cacheCountLimit: 6000
  concurrentPutRequests: 64
  # Durable (S3/ABS) storage off: writes add etcd events and latency. Changing it on a live
  # install needs an etcd wipe, which empties the result cache.
  durableStorageType: ""
  storage:
    # Holds the flight catalog (SQLite); must scale with limitFlightCount. 1Gi evicted pods.
    serverWorkDirSize: 4096Mi
    cache:
      diskCacheSize: 25Gi
      diskSize: 30Gi
  replicaCount:
    # cache serves every DoGet + absorbs DoPut/S3 writes on cache miss; 2 pods
    # saturated the put pipeline under load.
    cache: 12
    # xtab is I/O-bound (Flight reads from cache); 8 pods with capped worker
    # pools (extraEnvVarsXtab) keep the queue clear without swamping the cache.
    xtab: 16
    datasource: 4
    policy: 4
  resources:
    cache:
      # Needs real CPU headroom: the single-threaded etcd-view-apply loop needs a
      # full core; starving it makes consistency-checked Flight reads time out and
      # stall cross-tabs.
      limits:
        cpu: 4000m
        memory: 4096Mi
        ephemeral-storage: 30Gi
      requests:
        cpu: 2000m
        memory: 4096Mi
        ephemeral-storage: 30Gi
    xtab:
      # Bursty CPU (worker subprocesses run short polars ops); needs headroom
      # despite a low average, so the limit sits well above steady-state.
      limits:
        cpu: 4000m
        memory: 7680Mi
      requests:
        cpu: 2000m
        # Set above observed peak RSS (still under the limit) so the scheduler
        # can't overcommit nodes and evict xtab pods under load.
        memory: 5120Mi
    ml:
      limits:
        cpu: 2000m
        memory: 5120Mi
      requests:
        cpu: 1000m
        memory: 2560Mi
    datasource:
      limits:
        cpu: 4000m
        memory: 2560Mi
      requests:
        cpu: 1500m
        memory: 2560Mi
    policy:
      limits:
        cpu: 4000m
        memory: 6144Mi
      requests:
        cpu: 2000m
        memory: 6144Mi
  extraEnvVarsCache:
    # Rust etcd event apply; Helm replaces lists, so every list repeats it.
    - name: QUIVER_USE_RUST_EXTENSION
      value: "1"
    # Wait up to 120 s (default 10 s) for etcd at start, or Quiver exits with "future revision".
    - name: QUIVER_ETCD_INIT_MAX_DELAY
      value: "120"
    # Flight-catalog VACUUM threshold (default 50000): a higher value stalls the catalog less often.
    - name: QUIVER_FCAT_VACUUM_DT
      value: "250000"
  extraEnvVarsDatasource:
    # Rust etcd event apply; Helm replaces lists, so every list repeats it.
    - name: QUIVER_USE_RUST_EXTENSION
      value: "1"
    # Wait up to 120 s (default 10 s) for etcd at start, or Quiver exits with "future revision".
    - name: QUIVER_ETCD_INIT_MAX_DELAY
      value: "120"
    # Flight-catalog VACUUM threshold (default 50000): a higher value stalls the catalog less often.
    - name: QUIVER_FCAT_VACUUM_DT
      value: "250000"
  extraEnvVarsMl:
    # Rust etcd event apply; Helm replaces lists, so every list repeats it.
    - name: QUIVER_USE_RUST_EXTENSION
      value: "1"
    # Wait up to 120 s (default 10 s) for etcd at start, or Quiver exits with "future revision".
    - name: QUIVER_ETCD_INIT_MAX_DELAY
      value: "120"
    # Flight-catalog VACUUM threshold (default 50000): a higher value stalls the catalog less often.
    - name: QUIVER_FCAT_VACUUM_DT
      value: "250000"
  extraEnvVarsPolicy:
    # Rust etcd event apply; Helm replaces lists, so every list repeats it.
    - name: QUIVER_USE_RUST_EXTENSION
      value: "1"
    # Wait up to 120 s (default 10 s) for etcd at start, or Quiver exits with "future revision".
    - name: QUIVER_ETCD_INIT_MAX_DELAY
      value: "120"
    # Flight-catalog VACUUM threshold (default 50000): a higher value stalls the catalog less often.
    - name: QUIVER_FCAT_VACUUM_DT
      value: "250000"
  extraEnvVarsXtab:
    - name: QUIVER_USE_RUST_EXTENSION
      value: "1"
    - name: QUIVER_ETCD_INIT_MAX_DELAY
      value: "120"
    - name: QUIVER_FCAT_VACUUM_DT
      value: "250000"
    # Cap the dataframe worker pool: xtab spawns TASK_WORKERS subprocesses
    # sequentially at boot (~2s each, importing polars), so a high count (was 24)
    # pushed startup past the liveness probe on slower/contended nodes and the pod
    # self-terminated mid-boot. 8 boots in ~15-20s (under the probe) while keeping
    # enough concurrency for the I/O-bound cross-tab tasks. POLARS_MAX_THREADS caps
    # per-worker polars threads to avoid CPU oversubscription.
    - name: QUIVER_DATAFRAME_TASK_THREADS
      value: "16"
    # 16 workers per pod: 12 left a 3,400-request queue with idle CPU.
    - name: QUIVER_DATAFRAME_TASK_WORKERS
      value: "16"
    - name: QUIVER_DATAFRAME_GATHER_THREADS
      value: "8"
    - name: POLARS_MAX_THREADS
      value: "6"
  # Store the Flight catalog on disk (in the server work dir above).
  optimizations:
    etcd_disk_flight_catalog: true
redis-ha:
  replicas: 3
  persistentVolume:
    size: 20Gi
  # Keep 2/3 sentinel quorum during voluntary disruptions (node drains, Karpenter consolidation)
  podDisruptionBudget:
    maxUnavailable: 1
  configmapTest:
    resources:
      limits:
        cpu: 50m
        memory: 40Mi
      requests:
        cpu: 20m
        memory: 40Mi
  exporter:
    resources:
      limits:
        cpu: 200m
        memory: 20Mi
      requests:
        cpu: 30m
        memory: 20Mi
  redis:
    config:
      maxmemory: 7300m
    resources:
      limits:
        cpu: 2000m
        memory: 12Gi
      requests:
        cpu: 1500m
        memory: 12Gi
  sentinel:
    resources:
      limits:
        cpu: 100m
        memory: 35Mi
      requests:
        cpu: 50m
        memory: 35Mi
  splitBrainDetection:
    resources:
      requests:
        memory: 64Mi
        cpu: 30m
      limits:
        memory: 64Mi
        cpu: 150m
resultCache:
  # Runs the execution plan for every AFM. Kotlin sizes dispatchers from the CPU
  # count; without ActiveProcessorCount ~200 executions/pod contend for ~6 threads
  # (~4.7s vs ~0.3s), holding api-gw's forward pool open. Widen and scale out.
  jvmOptions: -XX:MaxMetaspaceSize=384M -XX:MaxDirectMemorySize=384M -XX:ActiveProcessorCount=8 -Dkotlinx.coroutines.io.parallelism=256 -XX:MaxRAMPercentage=58
  # Deploys at the autoscaling floor; the ceiling of 16 at 4000m is
  # peak-provisioned, since fewer/smaller replicas regress execute latency
  # sharply under load.
  replicaCount: 8
  kedaAutoscaling:
    behavior: *fastScaleUp
    minReplicaCount: 8
    maxReplicaCount: 24
  resources:
    limits:
      cpu: 5000m
      memory: 3600Mi
    requests:
      cpu: 2000m
      memory: 3600Mi
  pulsar:
    executionFinish:
      # Raise how many execution-finish messages a pod handles at once.
      maxConcurrentMessages: 200
  # Total result-cache size limit: 512 GiB.
  totalCacheLimit: 549755813888
  # Disable the dead Zipkin exporter (see metadataApi).
  extraEnvVars:
    - name: MANAGEMENT_ZIPKIN_TRACING_EXPORT_ENABLED
      value: "false"
scanModel:
  jvmOptions: -Xmx220M -XX:MaxMetaspaceSize=160M -XX:MaxDirectMemorySize=32M
  resources:
    limits:
      cpu: 500m
      memory: 700Mi
    requests:
      cpu: 100m
      memory: 700Mi
sqlExecutor:
  jvmOptions: -Xmx2048M -XX:MaxMetaspaceSize=256M -XX:MaxDirectMemorySize=512M -XX:ActiveProcessorCount=32
  extraEnvVars:
    - name: DS_POOL_MAXCONNECTIONS
      value: "12"
  # Pool per data source and pod: floor(0.8 x (max_connections - 10) / (16 pods x 4 data sources)) = 12.
  replicaCount: 16
  pulsar:
    sqlSelect:
      # Match pre-fetch depth to the JDBC pool size to avoid connection exhaustion.
      receiverQueueSize: 10
  resources:
    limits:
      cpu: 3000m
      memory: 4096Mi
    requests:
      # Lower CPU request packs more sqlExecutor replicas per node.
      cpu: 500m
      memory: 3700Mi
tabularExporter:
  resources:
    limits:
      cpu: 1500m
      memory: 7500Mi
    requests:
      cpu: 1000m
      memory: 7500Mi
# The old key, visualExporterChromium, matched no chart value.
exportBuilderChromium:
  resources:
    limits:
      cpu: 6000m
      memory: 8Gi
    requests:
      cpu: 2500m
      memory: 4Gi
visualExporterProxy:
  # 1 core: the squid sidecar was throttled at 300m.
  resources:
    limits:
      cpu: 1000m
      memory: 300Mi
    requests:
      cpu: 100m
      memory: 215Mi
visualExporterService:
  extraEnvVars:
    - name: SERVER_TOMCAT_THREADS_MAX
      value: "2"
    - name: SERVER_TOMCAT_ACCEPTCOUNT
      value: "500"
  jvmOptions: -Xmx432M -XX:MaxMetaspaceSize=192M -XX:MaxDirectMemorySize=16M
  replicaCount: 4
  resources:
    limits:
      cpu: 1000m
      memory: 1280Mi
    requests:
      cpu: 500m
      memory: 640Mi
webComponents:
  resources:
    limits:
      cpu: 200m
      memory: 45Mi
    requests:
      memory: 15Mi
exportBuilder:
  replicaCount: 8
  # Adjust maxReplicaCount to the expected export load: each replica carries a
  # Chromium container, so the ceiling drives both cost and node capacity.
  kedaAutoscaling:
    minReplicaCount: 8
    maxReplicaCount: 24
  export:
    visual:
      # 20 s timed out under load ("Timed out navigating to dashboard").
      navigateTimeout: 40s
      evaluateTimeout: 180s
    slides:
      navigateTimeout: 40s
      evaluateTimeout: 180s
      screenshotsMaxSize: 40MB
  # Chromium runs in a standalone container in the pod; export-builder connects
  # to it over the Chrome DevTools Protocol (CDP).
  playwright:
    concurrency:
      # Browser contexts per pod (default 4); the Chromium sidecar is sized for 8.
      maxInstances: 8
    browser:
      type: "cdp"
  # These settings must be aligned with resource.limits.memory value
  # The minimum memory limit in MeBiBytes is (codecachesize+Xmx+metaspace+175)*1.024
  jvmOptions: -XX:ReservedCodeCacheSize=60M -Xmx1500M -XX:MaxMetaspaceSize=210M -XX:MaxDirectMemorySize=128M
  resources:
    limits:
      cpu: 4000m
      # Additional 500Mi for Chromium
      memory: 2500Mi
    requests:
      cpu: 1000m
      memory: 550Mi
apiGw:
  # Ktor gateway. Each forward holds a CIO connection (~100/pod) for the full
  # backend call, so forward concurrency = ~100 x replicas.
  replicaCount: 4
  kedaAutoscaling:
    behavior: *fastScaleUp
    minReplicaCount: 4
    maxReplicaCount: 20
    targetCPUUtilization: 60
  # Enable Quiver's modern etcd keyspace (removes the single-threaded flight-
  # catalog view-apply stall under load). Platform feature-value flag.
  extraEnvVars:
    - name: GDC_FEATURES_VALUES_ENABLE_MODERN_QUIVER_KEYSPACE
      value: "true"
  database:
    pool:
      # Wider DB pool for higher concurrency (matches prod).
      maxSize: 32
      minIdle: 4
      maxAcquireTime: 30000
  resources:
    limits:
      cpu: 3000m
      memory: 3000Mi
    requests:
      cpu: 1000m
      memory: 3000Mi
  # io.parallelism has no effect here: the forward path is async CIO, not
  # Dispatchers.IO; the CIO pool above is the limit. Keep aligned with limits.memory.
  jvmOptions: "-XX:MaxDirectMemorySize=512m -XX:MaxRAMPercentage=50"
