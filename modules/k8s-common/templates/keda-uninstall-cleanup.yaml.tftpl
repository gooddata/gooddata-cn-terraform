# Keep the CRDs on uninstall so a later upgrade of the GoodData.CN release
# can still resolve the ScaledObject kind in its stored manifest.
crds:
  additionalAnnotations:
    helm.sh/resource-policy: keep

# Pre-delete hook: removes all ScaledObjects while the KEDA operator is
# still running, so it can process their finalizers and delete the HPAs it
# owns. Without this, uninstalling KEDA hangs on the CRD finalizers and
# leaves orphaned HPAs behind.
extraObjects:
  - apiVersion: v1
    kind: ServiceAccount
    metadata:
      name: keda-uninstall-cleanup
      namespace: ${namespace}
      annotations:
        helm.sh/hook: pre-delete
        helm.sh/hook-weight: "-2"
        helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
  - apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      name: keda-uninstall-cleanup
      annotations:
        helm.sh/hook: pre-delete
        helm.sh/hook-weight: "-1"
        helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
    rules:
      - apiGroups: ["keda.sh"]
        resources: ["scaledobjects", "scaledjobs"]
        verbs: ["get", "list", "watch", "delete"]
  - apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: keda-uninstall-cleanup
      annotations:
        helm.sh/hook: pre-delete
        helm.sh/hook-weight: "-1"
        helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: keda-uninstall-cleanup
    subjects:
      - kind: ServiceAccount
        name: keda-uninstall-cleanup
        namespace: ${namespace}
  - apiVersion: batch/v1
    kind: Job
    metadata:
      name: keda-uninstall-cleanup
      namespace: ${namespace}
      annotations:
        helm.sh/hook: pre-delete
        helm.sh/hook-weight: "0"
        helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
    spec:
      backoffLimit: 1
      activeDeadlineSeconds: 300
      template:
        spec:
          serviceAccountName: keda-uninstall-cleanup
          restartPolicy: Never
          containers:
            - name: kubectl
              image: registry.k8s.io/kubectl:v1.33.4
              command:
                - kubectl
                - delete
                - scaledobjects.keda.sh,scaledjobs.keda.sh
                - --all
                - --all-namespaces
                - --ignore-not-found
                - --timeout=240s
